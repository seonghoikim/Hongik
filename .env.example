# 실제 API로 실험을 돌릴 때만 필요합니다. mock 모드에서는 필요 없습니다.
# 이 파일을 복사해서 .env로 저장하고 실제 키를 채워 넣으세요. .env는 git에 올라가지 않습니다.
#
# 지도교수 피드백 반영 (thesis.md §3.5.5): 공격 생성/자가 치유 루프/헬드아웃/
# 적응형 재공격은 --primary-provider로 지정한 단일 모델 하나로만 진행한다.
# 그 결과가 특정 모델에 우연히 맞춰진 게 아닌지 확인하기 위해, 마지막에
# 헬드아웃 셋을 이종 LLM 2종을 더한 3개 백엔드로 다시 돌리고 채점은 주 모델
# 심판관 하나로 고정하는 "교차 모델 검증" 단계가 추가로 돈다(3개 중 2개
# 이상 PASS -> 검증됨). 이 단계 때문에 --mode real이면 3개 키가 전부 필요하다.
# 모델명은 자주 바뀌므로 실행 전 각 콘솔에서 사용 가능한 모델명인지 확인할 것.

# LLM_PROVIDER: mock | real  (run_experiment.py --mode 로 덮어쓸 수 있음)
LLM_PROVIDER=mock

# 주 모델(primary) = Anthropic Claude Sonnet 5 로 확정 (2026-08).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# 교차 모델 검증용 추가 백엔드 2종. 바닥 티어(mini/flash-lite/haiku)가 아닌
# 각 사의 균형 티어로 선정함 - 너무 약한 모델을 쓰면 "상용 LLM 수준의 검증"이라는
# 주장 자체가 약해지기 때문.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# 재현성을 위해 낮게 고정 (논문 §3.5.2)
LLM_TEMPERATURE=0.2
JUDGE_TEMPERATURE=0
