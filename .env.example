# 실제 API로 실험을 돌릴 때만 필요합니다. mock 모드에서는 필요 없습니다.
# 이 파일을 복사해서 .env로 저장하고 실제 키를 채워 넣으세요. .env는 git에 올라가지 않습니다.

# LLM_PROVIDER: mock | openai | gemini
LLM_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 재현성을 위해 낮게 고정 (논문 §3.5.2)
LLM_TEMPERATURE=0.2
JUDGE_TEMPERATURE=0
